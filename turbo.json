{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "tsconfig.tsbuildinfo"],
			// turbo hands the tasks only the variables declared here, wasm-pack needs them to run
			// cargo (toolchain, sccache) outside of the default locations
			"passThroughEnv": [
				"CARGO_*",
				"RUSTUP_*",
				"RUSTC_WRAPPER",
				"SCCACHE_*",
				"WASM_PACK_*"
			]
		}
	},
	"globalDependencies": [
		".eslintrc.js",
		".eslintignore",
		".lintstagedrc.js",
		".prettierrc.yaml",
		"tsconfig.base.json",
		"tsconfig.build.json",
		"tsconfig.json"
	]
}
